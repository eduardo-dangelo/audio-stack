{
  "expo": {
    "name": "Audio Stack",
    "slug": "audio-stack",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "voicememosplus",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "icon": "./assets/AppIcon.icon",
      "supportsTablet": true,
      "appleTeamId": "JD2R9CV986",
      "bundleIdentifier": "com.eduardodangelo.voicememosplus",
      "buildNumber": "28",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Audio Stack needs microphone access to record audio.",
        "NSLocationWhenInUseUsageDescription": "Audio Stack uses your location to name new recordings after the current place.",
        "NSLocalNetworkUsageDescription": "Audio Stack uses the local network to load the JavaScript bundle from your computer during development.",
        "NSBonjourServices": [
          "_http._tcp",
          "_expo._tcp",
          "_metro._tcp"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UISupportsDocumentBrowser": true,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.eduardodangelo.voicememosplus.project",
            "UTTypeDescription": "Audio Stack Project",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "aud",
                "vmp"
              ],
              "public.mime-type": [
                "application/vnd.audio-stack.project",
                "application/vnd.voicer-pro.project",
                "application/vnd.voice-memos-plus.project"
              ]
            }
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Audio Stack Project",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "CFBundleTypeExtensions": [
              "aud",
              "vmp"
            ],
            "LSItemContentTypes": [
              "com.eduardodangelo.voicememosplus.project"
            ]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "Audio Stack needs microphone access to record audio."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Audio Stack uses your location to name new recordings after the current place."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0F0F0F"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.eduardodangelo.voicememosplus.widgets",
          "groupIdentifier": "group.com.eduardodangelo.voicememosplus",
          "enablePushNotifications": false,
          "frequentUpdates": true
        }
      ],
      "./plugins/stripWidgetsPushEntitlement.js",
      "./plugins/stripAppIconAppiconset.js",
      "./plugins/withEndLiveActivitiesOnTerminate.js",
      "./plugins/withIosPodDeploymentTarget.js",
      "./plugins/withIosSceneLifecycle.js",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
